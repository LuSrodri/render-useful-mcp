# Required: Render API key (https://dashboard.render.com/u/settings#api-keys)
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: default workspace, auto-applied wherever an ownerId is needed.
# Find it with the render_list_owners tool, or in the dashboard URL.
# RENDER_WORKSPACE_ID=tea-xxxxxxxxxxxxxxxxxxxx

# Optional: narrow the exposed surface. Defaults to all 17 toolsets.
# RENDER_MCP_TOOLSETS=services,logs,postgres

# Optional: expose only non-mutating tools.
# RENDER_MCP_READ_ONLY=true

# Optional: allow the model to enable toolsets mid-session (default true).
# RENDER_MCP_DYNAMIC_TOOLSETS=true

# Optional tuning.
# RENDER_MCP_TIMEOUT_MS=60000
# RENDER_MCP_MAX_RETRIES=3
# RENDER_MCP_MAX_RESPONSE_BYTES=400000
# RENDER_MCP_LOG_LEVEL=info
# RENDER_API_BASE_URL=https://api.render.com/v1
