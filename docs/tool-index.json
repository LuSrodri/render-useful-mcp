    {
      "name": "render_create_job",
      "toolset": "services",
      "summary": "Create job.",
      "readOnly": false,
      "destructive": false,
      "usage": "Starts a one-off job on an existing service, reusing its image and environment. This is not how you create a cron job — a cron job is a service (render_create_service with `type`:`cron_job`), and render_run_cron_job triggers one off-schedule."
    },
